{
  "name": "@gami/core",
  "version": "0.1.0",
  "private": true,
  "description": "Gami DigiDouble Core — headless conversational orchestration engine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "seed:ai-guided-discovery": "tsx src/seed/ai-guided-discovery.ts",
    "seed:murder-party:api": "tsx src/seed/murder-party/setup-via-api.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "test:integration-e2e": "vitest run --config vitest.integration.config.ts",
    "test:stack-e2e": "vitest run --config vitest.stack-e2e.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@fastify/cors": "^11.2.0",
    "@gami/shared": "workspace:*",
    "@mistralai/mistralai": "^2.2.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "langfuse": "^3.38.20",
    "openai": "^6.34.0",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  }
}
