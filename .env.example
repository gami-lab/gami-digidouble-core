# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gami_core
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Integration tests only: recreated from infra/postgres/init.sql on every run and truncated by
# tests, so it must be a separate database whose name ends in _test (never DATABASE_URL).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gami_core_test

# ─────────────────────────────────────────────
# Cache / Session (Redis)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# API Authentication
# ─────────────────────────────────────────────
API_KEY_SECRET=change_me_in_production

# ─────────────────────────────────────────────
# CORS — allowed browser origin(s)
# ─────────────────────────────────────────────
# CORS_ORIGIN=*               # wildcard — dev & internal tools only
# CORS_ORIGIN=http://localhost:5173   # exact origin — recommended for production
CORS_ORIGIN=*

# ─────────────────────────────────────────────
# LLM Providers — add the providers you use
# ─────────────────────────────────────────────
LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=

# ─────────────────────────────────────────────
# Embeddings — independent from chat model selection
# ─────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# The current PostgreSQL schema stores the model's native VECTOR(1536) profile.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# ─────────────────────────────────────────────
# Voice input — routes are available; provider-backed transcription is optional
# ─────────────────────────────────────────────
# DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TIMEOUT_MS=30000
DEEPGRAM_DEFAULT_LANGUAGE=en

# ─────────────────────────────────────────────
# Voice output (text-to-speech) — optional; text keeps working without it
# ─────────────────────────────────────────────
# Every provider with an API key can be picked per scenario/avatar in the admin.
# TTS_PROVIDER names the default provider (gradium by default); null means no voice
# unless a scenario/avatar picks a provider.
TTS_PROVIDER=gradium
# GRADIUM_API_KEY=
# GRADIUM_BASE_URL=https://api.gradium.ai/api
# GRADIUM_TIMEOUT_MS=30000
# Voices are chosen per scenario/avatar in the admin (GET /v1/admin/voices).
# When none is chosen, Core uses the provider's default voice for the scenario language.

# ─────────────────────────────────────────────
# Observability (Langfuse — self-hosted preferred)
# ─────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3030

# ─────────────────────────────────────────────
# Knowledge source ingestion — local/mounted file access
# ─────────────────────────────────────────────
# Comma-separated list of directories that knowledge source uriOrPath values
# may resolve into for local text/markdown/pdf ingestion. Leave unset to
# disable local file access (URL sources still work).
# KNOWLEDGE_SOURCE_ALLOWED_ROOTS=/data/knowledge-sources
